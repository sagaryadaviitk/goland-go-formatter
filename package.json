{
  "name": "goland-go-formatter",
  "displayName": "GoLand Go Formatter",
  "description": "GoLand-inspired Go formatting without adding Go language-server diagnostics.",
  "version": "0.1.0",
  "publisher": "sagaryadaviitk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sagaryadaviitk/goland-go-formatter.git"
  },
  "homepage": "https://github.com/sagaryadaviitk/goland-go-formatter",
  "bugs": {
    "url": "https://github.com/sagaryadaviitk/goland-go-formatter/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:go"
  ],
  "categories": [
    "Formatters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "go",
    "golang",
    "gofmt",
    "gofumpt",
    "goimports",
    "formatter",
    "goland",
    "jetbrains"
  ],
  "contributes": {
    "configuration": {
      "title": "GoLand Go Formatter",
      "properties": {
        "golandGoFormatter.tool": {
          "type": "string",
          "default": "gofmt",
          "enum": [
            "gofmt",
            "goimports",
            "gofumpt"
          ],
          "description": "Go formatting tool to run through the GoLand Go Formatter extension."
        },
        "golandGoFormatter.extraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra command-line arguments passed to the selected formatter."
        },
        "golandGoFormatter.timeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "description": "Maximum time to wait for the formatter command."
        }
      }
    },
    "configurationDefaults": {
      "[go]": {
        "editor.defaultFormatter": "sagaryadaviitk.goland-go-formatter",
        "editor.formatOnSave": true
      }
    }
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "package": "npm run validate && npx @vscode/vsce package",
    "vscode:prepublish": "npm run validate"
  },
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#262B31",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GoLand Go Formatter runs local formatter commands against workspace files."
    },
    "virtualWorkspaces": false
  }
}
